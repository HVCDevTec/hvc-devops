[Unit]
Description=notes
After=network.target


[Service]
User=appuser
WorkingDirectory=/opt/notes
ExecStart=/usr/bin/java -jar -Djava.awt.headless=true -Djava.security.egd=file:/dev/./urandom /opt/notes/target/easy-notes-{{notes_version.stdout}}.jar
SyslogIdentifier=notes-%SyslogIdentifier

[Install]
WantedBy=multi-user.target
